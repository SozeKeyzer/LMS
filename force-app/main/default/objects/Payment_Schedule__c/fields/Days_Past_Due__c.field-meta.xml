<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Days_Past_Due__c</fullName>
    <description>Calendar days past due. Populated only when Status = Overdue.</description>
    <externalId>false</externalId>
    <formula>IF(ISPICKVAL(Status__c, 'Overdue'), TODAY() - Due_Date__c, 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Days Past Due</label>
    <precision>5</precision><scale>0</scale>
    <trackTrending>false</trackTrending>
    <type>Number</type>
</CustomField>