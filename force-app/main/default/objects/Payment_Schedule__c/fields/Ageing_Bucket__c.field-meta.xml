<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Ageing_Bucket__c</fullName>
    <description>Ageing bucket per spec section 2.3.3.</description>
    <externalId>false</externalId>
    <formula>IF(NOT(ISPICKVAL(Status__c, 'Overdue')), '', IF(Days_Past_Due__c &gt;= 90, 'Arrears_90_Plus', IF(Days_Past_Due__c &gt;= 60, 'Arrears_60', IF(Days_Past_Due__c &gt;= 30, 'Arrears_30', 'Early_Arrears'))))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Ageing Bucket</label>
    
    <trackTrending>false</trackTrending>
    <type>Text</type>
</CustomField>