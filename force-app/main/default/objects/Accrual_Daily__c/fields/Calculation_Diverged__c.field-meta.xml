<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Calculation_Diverged__c</fullName>
    <description>TRUE when Override_Value differs from Calculated_Value. Warning indicator in UI.</description>
    <externalId>false</externalId>
    <formula>AND(NOT(ISBLANK(Override_Value__c)), Override_Value__c &lt;&gt; Calculated_Value__c)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Calculation Diverged</label>
    
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>