<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Compounding_Frequency__c</fullName>
    <description>How often interest compounds within a period. None = simple interest (default). Daily / Monthly / Quarterly = discrete compounding. On_Cure = accumulate simple interest, compound at cure date (used on Default Interest IRT rows). Spec v7 Part 5.2.7, Part 2.11.2.</description>
    <label>Compounding Frequency</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value><fullName>None</fullName><default>true</default><label>None (Simple Interest)</label></value>
            <value><fullName>Daily</fullName><default>false</default><label>Daily</label></value>
            <value><fullName>Monthly</fullName><default>false</default><label>Monthly</label></value>
            <value><fullName>Quarterly</fullName><default>false</default><label>Quarterly</label></value>
            <value><fullName>On_Cure</fullName><default>false</default><label>On Cure</label></value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
