    <label>Fee Treatment</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value><fullName>Cash</fullName><default>true</default><label>Cash</label></value>
            <value><fullName>Capitalised</fullName><default>false</default><label>Capitalised</label></value>
            <value><fullName>Cash_or_Capitalised_Election</fullName><default>false</default><label>Cash or Capitalised (Borrower Election)</label></value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
