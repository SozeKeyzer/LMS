<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_DR_01_PositiveAmounts</fullName>
    <active>true</active>
    <description>Drawdown amounts must be positive.</description>
    <errorConditionFormula>Requested_Amount__c &lt;= 0</errorConditionFormula>
    <errorMessage>Requested Amount must be greater than zero.</errorMessage>
</ValidationRule>