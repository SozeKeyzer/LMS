                <fullName>Increase / Upsize</fullName>
                <default>false</default>
                <label>Increase / Upsize</label>
            </value>
            <value>
                <fullName>Refinance / Roll-over</fullName>
                <default>false</default>
                <label>Refinance / Roll-over</label>
            </value>
            <value>
                <fullName>Restructure / Amendment</fullName>
                <default>false</default>
                <label>Restructure / Amendment</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
