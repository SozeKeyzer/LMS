    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value><fullName>Not_Generated</fullName><default>true</default><label>Not Generated</label></value>
            <value><fullName>Draft</fullName><default>false</default><label>Draft</label></value>
            <value><fullName>Pending_Review</fullName><default>false</default><label>Pending Review</label></value>
            <value><fullName>Active</fullName><default>false</default><label>Active</label></value>
            <value><fullName>Superseded</fullName><default>false</default><label>Superseded</label></value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
