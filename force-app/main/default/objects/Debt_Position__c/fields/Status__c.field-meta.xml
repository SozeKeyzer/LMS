                <label>Matured</label>
            </value>
            <value>
                <fullName>Cancelled</fullName>
                <default>false</default>
                <label>Cancelled</label>
            </value>
            <value>
                <fullName>Closed – Early (Repaid)</fullName>
                <default>false</default>
                <label>Closed – Early (Repaid)</label>
            </value>
            <value>
                <fullName>Closed – Early (Refinanced)</fullName>
                <default>false</default>
                <label>Closed – Early (Refinanced)</label>
            </value>
            <value>
                <fullName>Pending Approval</fullName>
