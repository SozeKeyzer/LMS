<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_PT_06_ReversalFields</fullName>
    <active>true</active>
    <description>VR.PT.06</description>
    <errorConditionFormula>ISPICKVAL(Status__c,'Reversed') &amp;&amp; (ISBLANK(Reversal_Date__c) || ISBLANK(Reversal_Reason__c) || ISBLANK(Reversed_By__c))</errorConditionFormula>
    <errorMessage>Reversal Date, Reversal Reason, and Reversed By are all required when Status = Reversed.</errorMessage>
</ValidationRule>