<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Grants operators the ability to transition calculation modes, submit overrides, and approve bulk recalculation runs. Does not grant access to calculator configuration or strategy class management.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Manual Mode Operator</label>
    <license>Salesforce</license>

    <!-- Calc_Mode_Change__c — create and manage mode transition episodes -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Calc_Mode_Change__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Calculation_Override__c — submit and view override requests -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Calculation_Override__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Calculation_Run__c — read-only audit trail access -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Calculation_Run__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Cascade_Run__c — read-only to trace cascade chains -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Cascade_Run__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Calculation_Shadow_Comparison__c — review shadow diffs before promoting -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Calculation_Shadow_Comparison__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Bulk_Recalculation_Run__c — approve and monitor bulk runs -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Bulk_Recalculation_Run__c</object>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>

    <!-- Debt_Position__c — Calc_Mode fields only -->
    <fieldPermissions>
        <editable>true</editable>
        <field>Debt_Position__c.Calc_Mode__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Debt_Position__c.Calc_Mode_Since__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Debt_Position__c.Active_Mode_Change__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- Financial_Instrument__c — Calc_Mode fields only -->
    <fieldPermissions>
        <editable>true</editable>
        <field>Financial_Instrument__c.Calc_Mode__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Financial_Instrument__c.Calc_Mode_Since__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Financial_Instrument__c.Active_Mode_Change__c</field>
        <readable>true</readable>
    </fieldPermissions>

    <!-- Apex class access -->
    <classAccesses>
        <apexClass>CalcModeService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>CalcReadinessController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>CascadePreviewController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>CalculationOrchestrator</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>ShadowComparisonService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>BulkRecalculationService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
</PermissionSet>
