<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <description>Screen Flow for capturing a new Drawdown Request. Creates Drawdown_Request__c for ops approval.</description>
    <interviewLabel>Drawdown Request Screen {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Drawdown Request Screen</label>
    <processType>Flow</processType>
    <status>Active</status>

    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>requestedAmount</name>
        <dataType>Currency</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
    </variables>
    <variables>
        <name>requestedDate</name>
        <dataType>Date</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>noticeReceivedDate</name>
        <dataType>Date</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>newDrawdownId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>

    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Capture_Drawdown_Details</targetReference></connector>
    </start>

    <!-- Screen fields use input_ prefix to avoid name clash with variables -->
    <screens>
        <name>Capture_Drawdown_Details</name>
        <label>Drawdown Request Details</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>input_requestedAmount</name>
            <dataType>Currency</dataType>
            <fieldText>Requested Amount (AUD)</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <scale>2</scale>
        </fields>
        <fields>
            <name>input_requestedDate</name>
            <dataType>Date</dataType>
            <fieldText>Requested Drawdown Date</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>input_noticeReceivedDate</name>
            <dataType>Date</dataType>
            <fieldText>Notice Received Date</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <connector><targetReference>Assign_Drawdown_Outputs</targetReference></connector>
    </screens>

    <!-- Assign screen outputs to variables -->
    <assignments>
        <name>Assign_Drawdown_Outputs</name>
        <label>Assign Screen Outputs to Variables</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <assignmentItems>
            <assignToReference>requestedAmount</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>input_requestedAmount</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>requestedDate</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>input_requestedDate</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>noticeReceivedDate</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>input_noticeReceivedDate</elementReference></value>
        </assignmentItems>
        <connector><targetReference>Create_Drawdown_Record</targetReference></connector>
    </assignments>

    <recordCreates>
        <name>Create_Drawdown_Record</name>
        <label>Create Drawdown Request Record</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <assignRecordIdToReference>newDrawdownId</assignRecordIdToReference>
        <inputAssignments>
            <field>Debt_Position__c</field>
            <value><elementReference>recordId</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Requested_Amount__c</field>
            <value><elementReference>requestedAmount</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Requested_Drawdown_Date__c</field>
            <value><elementReference>requestedDate</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Notice_Received_Date__c</field>
            <value><elementReference>noticeReceivedDate</elementReference></value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value><stringValue>Submitted</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>Source__c</field>
            <value><stringValue>Manual_Entry</stringValue></value>
        </inputAssignments>
        <object>Drawdown_Request__c</object>
    </recordCreates>
</Flow>