<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <description>When Payment_Transaction Status changes to Cleared, triggers allocation via PaymentService (handled in trigger handler — this flow logs the event).</description>
    <label>Payment Transaction Cleared</label>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>
    <start>
        <locationX>176</locationX><locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters><field>Status__c</field><operator>IsChanged</operator><value><booleanValue>true</booleanValue></value></filters>
        <filters><field>Status__c</field><operator>EqualTo</operator><value><stringValue>Cleared</stringValue></value></filters>
        <object>Payment_Transaction__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
        <connector><targetReference>Log_Cleared_Event</targetReference></connector>
    </start>
    <actionCalls>
        <name>Log_Cleared_Event</name>
        <label>Log Payment Cleared Audit Event</label>
        <locationX>176</locationX><locationY>120</locationY>
        <actionName>AuditEventLogger</actionName>
        <actionType>apex</actionType>
        <inputParameters><name>eventType</name><value><stringValue>PAYMENT_ALLOCATED</stringValue></value></inputParameters>
        <inputParameters><name>objectApiName</name><value><stringValue>Payment_Transaction__c</stringValue></value></inputParameters>
        <inputParameters><name>recordId</name><value><elementReference>$Record.Id</elementReference></value></inputParameters>
        <inputParameters><name>source</name><value><stringValue>System_Calculated</stringValue></value></inputParameters>
        <inputParameters><name>reason</name><value><stringValue>Payment Transaction cleared. Waterfall allocation triggered by handler.</stringValue></value></inputParameters>
    </actionCalls>
</Flow>