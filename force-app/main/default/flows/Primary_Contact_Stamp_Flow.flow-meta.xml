<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <description>Record-Triggered Flow on Contact. When a Contact is created or its AccountId is updated and AccountId is not null, stamps Account.Primary_Contact__c = the Contact Id. Maintains a single Contact per Account.</description>
    <interviewLabel>Primary Contact Stamp Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Primary Contact Stamp Flow</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>176</locationX>
        <locationY>48</locationY>
        <doesRequireRecordChangedToMeetCriteria>false</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>IsNull</operator>
            <value><booleanValue>false</booleanValue></value>
        </filters>
        <object>Contact</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
        <connector>
            <targetReference>Update_Account_Primary_Contact</targetReference>
        </connector>
    </start>

    <recordUpdates>
        <name>Update_Account_Primary_Contact</name>
        <label>Update Account Primary Contact</label>
        <locationX>176</locationX>
        <locationY>180</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Primary_Contact__c</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>

    <status>Active</status>
</Flow>
