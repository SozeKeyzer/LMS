<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <description>Screen Flow for rate deferral, waiver, or re-application. Calls RateDeferralService via invocable.</description>
    <interviewLabel>Rate Deferral Screen {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Rate Deferral Screen</label>
    <processType>Flow</processType>
    <status>Active</status>

    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>decisionType</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value><stringValue>Apply</stringValue></value>
    </variables>
    <variables>
        <name>newApplicationDate</name>
        <dataType>Date</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>reviewDate</name>
        <dataType>Date</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>reason</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>

    <choices>
        <name>Apply_Choice</name>
        <choiceText>Apply</choiceText>
        <dataType>String</dataType>
        <value><stringValue>Apply</stringValue></value>
    </choices>
    <choices>
        <name>Defer_Choice</name>
        <choiceText>Defer</choiceText>
        <dataType>String</dataType>
        <value><stringValue>Defer</stringValue></value>
    </choices>
    <choices>
        <name>Waive_Period_Choice</name>
        <choiceText>Waive for This Period</choiceText>
        <dataType>String</dataType>
        <value><stringValue>Waive_Period</stringValue></value>
    </choices>
    <choices>
        <name>Waive_Permanently_Choice</name>
        <choiceText>Waive Permanently</choiceText>
        <dataType>String</dataType>
        <value><stringValue>Waive_Permanently</stringValue></value>
    </choices>

    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Rate_Decision_Screen</targetReference></connector>
    </start>

    <!-- Screen fields use input_ prefix to avoid name clash with variables -->
    <screens>
        <name>Rate_Decision_Screen</name>
        <label>Rate Application Decision</label>
        <locationX>176</locationX>
        <locationY>120</locationY>
        <allowBack>false</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>input_decisionType</name>
            <choiceReferences>Apply_Choice</choiceReferences>
            <choiceReferences>Defer_Choice</choiceReferences>
            <choiceReferences>Waive_Period_Choice</choiceReferences>
            <choiceReferences>Waive_Permanently_Choice</choiceReferences>
            <dataType>String</dataType>
            <defaultSelectedChoiceReference>Apply_Choice</defaultSelectedChoiceReference>
            <fieldText>Decision Type</fieldText>
            <fieldType>RadioButtons</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>input_newApplicationDate</name>
            <dataType>Date</dataType>
            <fieldText>New Application Date</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
            <visibilityRule>
                <conditionLogic>and</conditionLogic>
                <conditions>
                    <leftValueReference>input_decisionType</leftValueReference>
                    <operator>EqualTo</operator>
                    <rightValue><stringValue>Defer</stringValue></rightValue>
                </conditions>
            </visibilityRule>
        </fields>
        <fields>
            <name>input_reviewDate</name>
            <dataType>Date</dataType>
            <fieldText>Deferral Review Date</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>input_reason</name>
            <dataType>String</dataType>
            <fieldText>Reason (mandatory)</fieldText>
            <fieldType>LargeTextArea</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <connector><targetReference>Assign_Screen_Outputs</targetReference></connector>
    </screens>

    <!-- Assign screen field values to variables -->
    <assignments>
        <name>Assign_Screen_Outputs</name>
        <label>Assign Screen Outputs to Variables</label>
        <locationX>176</locationX>
        <locationY>240</locationY>
        <assignmentItems>
            <assignToReference>decisionType</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>input_decisionType</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>newApplicationDate</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>input_newApplicationDate</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>reviewDate</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>input_reviewDate</elementReference></value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>reason</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>input_reason</elementReference></value>
        </assignmentItems>
        <connector><targetReference>Apply_Rate_Decision</targetReference></connector>
    </assignments>

    <actionCalls>
        <name>Apply_Rate_Decision</name>
        <label>Apply Rate Decision via RateDeferralService</label>
        <locationX>176</locationX>
        <locationY>360</locationY>
        <actionName>RateDeferralService</actionName>
        <actionType>apex</actionType>
        <inputParameters>
            <name>interestRateTermsId</name>
            <value><elementReference>recordId</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>decisionType</name>
            <value><elementReference>decisionType</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>newApplicationDate</name>
            <value><elementReference>newApplicationDate</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>reviewDate</name>
            <value><elementReference>reviewDate</elementReference></value>
        </inputParameters>
        <inputParameters>
            <name>reason</name>
            <value><elementReference>reason</elementReference></value>
        </inputParameters>
    </actionCalls>
</Flow>